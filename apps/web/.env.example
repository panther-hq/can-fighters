# API base URL used by the axios client. Defaults to the Vite dev proxy ("/api").
VITE_API_URL=/api

# Where the Vite dev-server proxy forwards /api and /sanctum.
# Docker: http://api:8000  ·  bare host: http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000

# Reverb / Laravel Echo (used from Phase 9 onward)
VITE_REVERB_APP_KEY=local-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

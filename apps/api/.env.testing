# Loaded automatically when APP_ENV=testing (set by phpunit.xml).
# Keeps the test suite off the dev Postgres/Redis and in a fast, isolated state.
APP_NAME="Can Fighters"
APP_ENV=testing
APP_KEY=base64:gjxM8gxmSj1LtfoCW5d83Yr7ymy/keaLIIfHa7oLE2k=
APP_DEBUG=true
APP_URL=http://localhost

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null

MAIL_MAILER=array

# Sanctum treats requests as first-party SPA (tests send Origin: http://localhost)
SANCTUM_STATEFUL_DOMAINS=localhost

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
